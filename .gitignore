.DS_Store
node_modules
.secrets
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
env.yaml
!env.yaml.template
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
temp
.claude/settings.local.json
CLAUDE.local.md
*.lnk
logs/

# SvelteKit build output
static/_app/

# ONNX Runtime prebuilts downloaded by scripts/ensure-ort.mjs (per-dev, per-platform)
.ort/

# TypeScript incremental build cache
*.tsbuildinfo

# Local debug/data dumps
echophrase-data-*.json

# Generated macOS app-icon build artifacts (regenerated by `bun run icons:mac`;
# committed source of truth + previews live in src-tauri/icons/mac/)
src-tauri/icons/.appicon-build/
src-tauri/icons/Assets.xcassets/

# Generated OSS license manifest (build artifact; merged into echophrase-www by gen-attribution.mjs)
static/oss-licenses.json
# Generated by scripts/env/load.mjs when DEV_PORT != 8420
.tauri-dev-port.json

# Rust build output (any target dir: target/, target-win/, ...)
target*/
# Local scratch dirs at the repo root only
/thoughts/
/tools/

# Playwright MCP browser session output (snapshots, downloads) - never commit
.playwright-mcp/
