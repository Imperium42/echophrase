# One line-ending rule for every machine, whatever its core.autocrlf: LF in the
# repo and in working trees. Without this, tools writing LF on a Windows
# autocrlf=true checkout leave phantom "modified" files.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Third-party license texts stay byte-exact as shipped.
src-tauri/licenses/** -text
