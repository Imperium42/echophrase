# Echophrase Environment Configuration Template
# Copy this file to env.yaml and customize for your setup
# Platform-specific settings override shared settings

# Shared configuration for all platforms
shared:
  # Dev server port (Vite). HMR uses this + 1. Leave at the default unless this machine cannot
  # bind it (Windows Hyper-V randomly reserves port ranges - see CLAUDE.md "Ports").
  # Uncomment to override (per machine, env.yaml is gitignored):
  # DEV_PORT: 5173

  # Telemetry (self-hosted Aptabase at telemetry.echophrase.com)
  APTABASE_APP_KEY: "A-SH-PLACEHOLDER"  # Get from Aptabase dashboard

  # CTranslate2 Optimizations
  CT2_CUDA_TRUE_FP16_GEMM: "1"
  CT2_USE_EXPERIMENTAL_PACKED_GEMM: "1"

  # Performance Settings
  OMP_NUM_THREADS: "8"  # Adjust based on your CPU cores
  CUDA_DEVICE_ORDER: "PCI_BUS_ID"
  CUDA_VISIBLE_DEVICES: "0"  # Change if using different GPU

  # OpenGL Software Rendering (for compatibility)
  LIBGL_ALWAYS_SOFTWARE: "1"

# WSL-specific configuration
wsl:
  # WebKitGTK rendering: the DMA-BUF renderer tears/flickers under WSLg
  # (settings rows visibly vanish on rapid pointer sweep + scroll). Forcing the
  # legacy buffer path fixes it. Linux/WSL only; inert elsewhere.
  WEBKIT_DISABLE_DMABUF_RENDERER: "1"
  # CUDA is DISABLED on Linux/WSL - transcription runs on CPU. Build-affecting
  # CUDA vars (CC/CXX, RUSTFLAGS, LIBRARY_PATH, NVCC_PREPEND_FLAGS,
  # CMAKE_CUDA_COMPILER, CUDA_TOOLKIT_ROOT_DIR, ORT_CUDA_VERSION) are deliberately
  # absent: they only perturbed the build while the `cuda` cargo feature stayed
  # off. Rationale + full re-enable recipe:
  #   docs/gpu-and-cuda.md
  # The env schema uses .passthrough(), so re-adding those keys here just works.

  # CUDA runtime paths - Update version if different. Harmless to the build.
  CUDA_HOME: "/usr/local/cuda-12"
  CUDNN_PATH: "/usr/local/cuda-12"

  # ONNX Runtime: ort 2.0.0-rc.12 uses load-dynamic to load onnxruntime at runtime.
  # Download ORT 1.24.2 GPU release from github.com/microsoft/onnxruntime/releases/tag/v1.24.2
  # Linux: onnxruntime-linux-x64-gpu-1.24.2.tgz
  ORT_DYLIB_PATH: "${HOME}/.local/lib/onnxruntime/onnxruntime-linux-x64-gpu-1.24.2/lib/libonnxruntime.so"

  # ORT_LOG: controls ONNX Runtime's internal log verbosity. Default is "error"
  # which hides CUDA EP load failures (logged at warning level). Set to "warning"
  # to see why the CUDA provider fails to load (gencode mismatch, missing libs, etc.)
  ORT_LOG: "warning"


  # Library Paths - RUNTIME only (dlopen search). Keeps /usr/lib/wsl/lib on the
  # path for NVML (libnvidia-ml) used by the GPU probe. The link-time twin
  # (LIBRARY_PATH) and RUSTFLAGS live in the disabled CUDA block above.
  LD_LIBRARY_PATH: "/usr/lib/wsl/lib:/usr/local/cuda-13/lib64:/usr/local/cuda-12/lib64:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"
  PATH: "/usr/local/cuda/bin:${PATH}"

  # Model Paths
  CT2_MODEL_DIR: "${HOME}/.cache/huggingface/hub"
  WHISPER_MODELS_PATH: "${HOME}/.cache/whisper-models"

  # Audio Configuration (WSLg PulseAudio)
  PULSE_SERVER: "/mnt/wslg/PulseServer"

  # Development Paths - Update to your paths
  TAURI_PROJECT_PATH: "${HOME}/projects/echophrase"
  CT2RS_PATCH_PATH: "${HOME}/ct2rs-patched"

# Windows-specific configuration
# REQUIREMENTS:
# - Visual Studio 2022 with "Desktop development with C++" workload
# - CUDA Toolkit 12.8+ with cuDNN 9.5.1+
# - Use PowerShell launcher: pwsh -ExecutionPolicy Bypass scripts/win/dev.ps1
windows:
  # ONNX Runtime: load-dynamic mode.
  # Production installer ships the DirectML runtime (~15MB, universal GPU on Windows).
  # CUDA is a user-opt-in download managed by src/ort_plugin/ - see Settings > GPU.
  # For dev: point ORT_DYLIB_PATH at whichever 1.24.2 package you have locally.
  # NOTE: GitHub's `-gpu-` zip has CUDA+TensorRT ONLY, no DirectML. For DirectML
  # development use the NuGet package Microsoft.ML.OnnxRuntime.DirectML 1.24.2:
  # curl -L -o ort-dml.nupkg https://www.nuget.org/api/v2/package/Microsoft.ML.OnnxRuntime.DirectML/1.24.2
  ORT_DYLIB_PATH: "C:/Users/YOU/onnxruntime-directml-1.24.2/runtimes/win-x64/native/onnxruntime.dll"

  # CUDA Paths - Update version to match your installation
  CUDA_HOME: "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8"
  CUDA_PATH: "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8"
  CUDNN_PATH: "C:/Program Files/NVIDIA/CUDNN/v9.13"
  CUDA_TOOLKIT_ROOT_DIR: "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8"
  CMAKE_CUDA_COMPILER: "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/bin/nvcc.exe"

  # Visual Studio paths for CUDA compilation
  CMAKE_GENERATOR: "Visual Studio 17 2022"
  CMAKE_GENERATOR_PLATFORM: "x64"
  CMAKE_SH: "CMAKE_SH-NOTFOUND"
  NVCC_APPEND_FLAGS: "-allow-unsupported-compiler"
  
  # Official CTranslate2 CMake configuration for Windows CUDA
  CMAKE_ARGS: "-DWITH_CUDA=ON -DWITH_CUDNN=ON -DCUDA_DYNAMIC_LOADING=ON -DCUDA_ARCH_LIST=Auto"
  
  # Direct NVCC environment setup to bypass vcvars64.bat issues  
  CUDA_NVCC_FLAGS: '-ccbin="C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64/cl.exe"'
  CMAKE_CUDA_FLAGS: '-ccbin="C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64/cl.exe"'
  
  # Force CC/CXX to use MSVC instead of Git bash tools
  CC: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64/cl.exe"
  CXX: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64/cl.exe"
  
  # Rust compilation flags for Windows ct2rs (required)
  RUSTFLAGS: "-C target-feature=+crt-static"
  
  # Force Rust to use Visual Studio linker instead of Git's link.exe
  RUSTC_LINKER: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64/link.exe"

  # Visual Studio Environment Setup (Required for NVCC to find vcvars64.bat)
  VS170COMNTOOLS: "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/Tools/"
  VSINSTALLDIR: "C:/Program Files/Microsoft Visual Studio/2022/Community/"
  VCToolsInstallDir: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/"
  VCINSTALLDIR: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/"
  WindowsSdkDir: "C:/Program Files (x86)/Windows Kits/10/"
  WindowsSDKVersion: "10.0.22621.0"
  
  # Force NVCC to use specific vcvars batch file
  CUDA_PATH_V12_8: "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8"
  
  # Override vcvars location for NVCC
  VCVARS_VER: "14.43"
  DevEnvDir: "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/"
  
  # Force CMAKE to use specific CUDA host compiler (bypass vcvars64.bat issues)
  CMAKE_CUDA_HOST_COMPILER: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64/cl.exe"
  CUDAHOSTCXX: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64/cl.exe"

  # Library Paths - Minimal PATH to avoid "input line too long" error in NVCC
  # SOLUTION: NVCC fails when PATH is too long, so we use minimal essential paths only
  PATH: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/Hostx64/x64;C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE;C:/Program Files (x86)/Windows Kits/10/bin/10.0.22621.0/x64;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/bin;C:/Program Files/CMake/bin;C:/Windows/System32;C:/Windows;${USERPROFILE}/.bun/bin;${USERPROFILE}/.cargo/bin"
  LIB: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/lib/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.22621.0/um/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.22621.0/ucrt/x64;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/lib/x64;C:/Program Files/NVIDIA/CUDNN/v9.13/lib;${LIB}"
  INCLUDE: "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/include;C:/Program Files/NVIDIA/CUDNN/v9.13/include;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/include;C:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/ucrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/um;C:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/shared;${INCLUDE}"

  # Model Paths
  CT2_MODEL_DIR: "${USERPROFILE}/.cache/huggingface/hub"
  WHISPER_MODELS_PATH: "${USERPROFILE}/.cache/whisper-models"

  # Development Paths - Update to your paths
  TAURI_PROJECT_PATH: "${HOME}/projects/echophrase"
  CT2RS_PATCH_PATH: "${HOME}/ct2rs-patched"

  # Visual Studio Compiler - Update year if different
  MSVC_VERSION: "2022"

# Linux native configuration (non-WSL)
linux:
  # CUDA is DISABLED on native Linux too - same reasoning as the wsl block above.
  # Build-affecting CUDA vars are deliberately absent.
  #   docs/gpu-and-cuda.md

  # CUDA runtime paths - harmless to the build; kept for the GPU probe / NVML.
  CUDA_HOME: "/usr/local/cuda"
  CUDNN_PATH: "/usr/local/cuda"

  # ONNX Runtime: load-dynamic mode (same as WSL default above)
  ORT_DYLIB_PATH: "${HOME}/.local/lib/onnxruntime/onnxruntime-linux-x64-gpu-1.24.2/lib/libonnxruntime.so"

  # Library Paths - RUNTIME only (dlopen search). Link-time twin (LIBRARY_PATH)
  # is intentionally absent while CUDA is off.
  LD_LIBRARY_PATH: "/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
  PATH: "/usr/local/cuda/bin:${PATH}"

  # Model Paths
  CT2_MODEL_DIR: "${HOME}/.cache/huggingface/hub"
  WHISPER_MODELS_PATH: "${HOME}/.cache/whisper-models"

  # Development Paths
  TAURI_PROJECT_PATH: "${HOME}/projects/echophrase"

# macOS configuration (uses Metal GPU or CPU - no CUDA needed)
macos:
  # Performance
  OMP_NUM_THREADS: "8"

  # ONNX Runtime: load-dynamic mode
  # macOS: onnxruntime-osx-arm64-1.24.2.tgz from GitHub releases
  ORT_DYLIB_PATH: "${HOME}/.local/lib/onnxruntime/onnxruntime-osx-arm64-1.24.2/lib/libonnxruntime.dylib"

  # Model Paths
  CT2_MODEL_DIR: "${HOME}/.cache/huggingface/hub"
  WHISPER_MODELS_PATH: "${HOME}/.cache/whisper-models"

  # Development Paths
  TAURI_PROJECT_PATH: "${HOME}/projects/echophrase"