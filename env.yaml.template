# Echophrase Environment Configuration Template
# Copy this file to env.yaml and customize for your setup
# Platform-specific settings override shared settings.
# There is no CUDA: Windows uses DirectML, macOS uses CoreML, Linux/WSL runs on CPU.
# See docs/gpu-and-cuda.md.
#
# TODO: GPU acceleration on Linux/WSL (likely CUDA). Linux has no out-of-the-box
# GPU path like DirectML or CoreML, so this needs its own design (driver/toolkit
# detection, ORT CUDA build matching the user's CUDA major). Contributions welcome.

# Shared configuration for all platforms
shared:
  # Dev server port (Vite). HMR uses this + 1. Leave at the default unless this machine cannot
  # bind it (Windows Hyper-V randomly reserves port ranges - see CLAUDE.md "Ports").
  # Uncomment to override (per machine, env.yaml is gitignored):
  # DEV_PORT: 5173

  # Telemetry (self-hosted Aptabase at telemetry.echophrase.com)
  APTABASE_APP_KEY: "A-SH-PLACEHOLDER"  # Get from Aptabase dashboard

  # Performance Settings
  OMP_NUM_THREADS: "8"  # Adjust based on your CPU cores

  # OpenGL Software Rendering (for compatibility)
  LIBGL_ALWAYS_SOFTWARE: "1"

# WSL-specific configuration (CPU-only for now - see the GPU TODO at the top)
wsl:
  # WebKitGTK rendering: the DMA-BUF renderer tears/flickers under WSLg
  # (settings rows visibly vanish on rapid pointer sweep + scroll). Forcing the
  # legacy buffer path fixes it. Linux/WSL only; inert elsewhere.
  WEBKIT_DISABLE_DMABUF_RENDERER: "1"

  # ONNX Runtime: ort uses load-dynamic to load onnxruntime at runtime.
  # `bun run tauri:dev` / `bun run setup:ort` downloads it to .ort/ and rewrites this path.
  ORT_DYLIB_PATH: "${HOME}/.local/lib/onnxruntime/onnxruntime-linux-x64-1.24.2/lib/libonnxruntime.so"

  # ONNX Runtime's internal log verbosity ("error" by default). "warning" shows
  # why an execution provider failed to load.
  ORT_LOG: "warning"

  # Runtime library search path. /usr/lib/wsl/lib holds the WSL GPU driver
  # libraries (NVML), which the GPU probe reads for the device name.
  LD_LIBRARY_PATH: "/usr/lib/wsl/lib:${LD_LIBRARY_PATH}"

  # Audio Configuration (WSLg PulseAudio)
  PULSE_SERVER: "/mnt/wslg/PulseServer"

# Windows-specific configuration
# REQUIREMENTS: Visual Studio 2022 with the "Desktop development with C++" workload.
# Cargo finds MSVC on its own; no compiler paths are needed here.
# Launcher: pwsh -ExecutionPolicy Bypass scripts/win/dev.ps1
windows:
  # ONNX Runtime: load-dynamic mode.
  # The production installer ships the DirectML runtime (universal GPU on Windows).
  # For dev, point ORT_DYLIB_PATH at the NuGet package Microsoft.ML.OnnxRuntime.DirectML 1.24.2:
  # curl -L -o ort-dml.nupkg https://www.nuget.org/api/v2/package/Microsoft.ML.OnnxRuntime.DirectML/1.24.2
  ORT_DYLIB_PATH: "C:/Users/YOU/onnxruntime-directml-1.24.2/runtimes/win-x64/native/onnxruntime.dll"

# Linux native configuration (non-WSL; CPU-only for now - see the GPU TODO at the top)
linux:
  # ONNX Runtime: load-dynamic mode (same as WSL above)
  ORT_DYLIB_PATH: "${HOME}/.local/lib/onnxruntime/onnxruntime-linux-x64-1.24.2/lib/libonnxruntime.so"

# macOS configuration (CoreML on Apple Silicon)
macos:
  # Performance
  OMP_NUM_THREADS: "8"

  # ONNX Runtime: load-dynamic mode
  # macOS: onnxruntime-osx-arm64-1.24.2.tgz from GitHub releases
  ORT_DYLIB_PATH: "${HOME}/.local/lib/onnxruntime/onnxruntime-osx-arm64-1.24.2/lib/libonnxruntime.dylib"
