{
  "name": "echophrase",
  "license": "MPL-2.0",
  "version": "0.9.9",
  "description": "Privacy-1st gpu speech→text desktop app",
  "author": "Imperium42",
  "homepage": "https://echophrase.com",
  "keywords": [
    "speech-to-text",
    "transcription",
    "privacy",
    "desktop",
    "tauri",
    "svelte"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imperium42/echophrase.git"
  },
  "bugs": {
    "url": "https://github.com/Imperium42/echophrase/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/imperium42"
  },
  "private": true,
  "scripts": {
    "vite:dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build && bunx --bun svelte-check",
    "preview": "bunx --bun vite preview",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run",
    "test:ui": "bunx --bun vitest --ui",
    "test:coverage": "bunx --bun vitest --coverage",
    "test:rust": "bun scripts/env/load.mjs -- cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:unit": "cargo test --manifest-path src-tauri/Cargo.toml -- test_resample test_execution test_normalize test_model_type",
    "test:rust:unit:win": "pwsh.exe -ExecutionPolicy Bypass -File scripts/win/test-unit.ps1",
    "test:transcription": "bun scripts/env/load.mjs wsl cargo test test_transcribe_audio_file --manifest-path src-tauri/Cargo.toml --lib -- --nocapture",
    "test:transcription:win": "pwsh.exe -ExecutionPolicy Bypass -File scripts/win/test-transcription.ps1",
    "test:vad": "bun scripts/env/load.mjs wsl cargo test test_vad --manifest-path src-tauri/Cargo.toml --lib -- --nocapture",
    "check": "bunx --bun svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bunx --bun svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "bunx --bun eslint src --ext .js,.ts,.svelte",
    "lint:fix": "bunx --bun eslint src --ext .js,.ts,.svelte --fix",
    "format": "bunx --bun prettier --write \"src/**/*.{js,ts,svelte,css,md,json}\"",
    "format:check": "bunx --bun prettier --check src/**/*.{js,ts,svelte,css,md}",
    "env:validate": "bun scripts/env/validate.mjs",
    "env:check-deps": "bun scripts/env/validate.mjs --check-paths",
    "tauri": "tauri",
    "setup:ort": "bun scripts/ensure-ort.mjs",
    "licenses:generate": "bun scripts/gen-attribution.mjs",
    "tauri:dev": "bun scripts/ensure-ort.mjs && bun scripts/env/load.mjs -- bun x tauri dev",
    "tauri:dev:wsl": "bun scripts/ensure-ort.mjs && bun scripts/env/load.mjs wsl bun x tauri dev",
    "tauri:dev:wsl:staging": "bun scripts/ensure-ort.mjs && bun scripts/env/load.mjs wsl --staging bun x tauri dev",
    "tauri:dev:windows": "bun scripts/env/load.mjs windows bun x tauri dev",
    "tauri:dev:windows:staging": "bun scripts/env/load.mjs windows --staging bun x tauri dev",
    "tauri:dev:mac": "bun scripts/ensure-ort.mjs && bun scripts/env/load.mjs macos bun x tauri dev",
    "tauri:dev:mac:staging": "bun scripts/ensure-ort.mjs && bun scripts/env/load.mjs macos --staging bun x tauri dev",
    "dev": "bun run tauri:dev",
    "dev:wsl": "bun run tauri:dev:wsl",
    "dev:windows": "bun run tauri:dev:windows",
    "dev:mac": "bun run tauri:dev:mac",
    "icons:mac": "bun scripts/macos/build-appicon.mjs",
    "tauri:build": "bun scripts/env/load.mjs -- bun x tauri build",
    "tauri:build:mac": "bun run icons:mac && bun scripts/env/load.mjs -- bun x tauri build && bash scripts/macos/inject-appicon.sh \"$(ls -d src-tauri/target/*/release/bundle/macos/Echophrase.app 2>/dev/null | head -1)\"",
    "tauri:build:win": "bunx --bun vite build && bunx tauri build",
    "tauri:build:win:staging": "bunx --bun vite build --mode staging && bunx tauri build --ci --features devtools",
    "tauri:build:win:prod": "bunx --bun vite build --mode production && bunx tauri build --ci --features official",
    "prepare": "bunx --bun svelte-kit sync && husky",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.24.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "autoprefixer": "^10.5.3",
    "bits-ui": "^2.18.1",
    "bumpp": "^10.4.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.2",
    "release-it": "^19.2.4",
    "rollup-license-plugin": "^3.2.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.5",
    "svelte-check": "^4.7.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "4.3.3",
    "tauri-version": "^1.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.2.4",
    "vitest": "3.2.7",
    "zod": "^4"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "hotkeys-js": "^3.13.15",
    "motion": "^12.42.2",
    "simple-icons": "^16.26.0",
    "visualization": "github:flo-bit/svelte-audio-visualizations"
  }
}
